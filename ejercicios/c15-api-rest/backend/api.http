@baseUrl = http://localhost:3000

### Listar libros
GET {{baseUrl}}/api/libros

### Filtrar libros disponibles
GET {{baseUrl}}/api/libros?disponible=true

### Obtener un libro
GET {{baseUrl}}/api/libros/1

### Libro inexistente - 404
GET {{baseUrl}}/api/libros/999

### Crear un libro - 201
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Rayuela",
  "autor": "Julio Cortázar",
  "precio": 17500,
  "imagen": "/img/rayuela.jpg",
  "descripcion": "Una novela fundamental de la literatura latinoamericana.",
  "disponible": true
}

### Actualizar un libro
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json

{
  "titulo": "El Eternauta",
  "autor": "Héctor Germán Oesterheld",
  "precio": 19000,
  "imagen": "/img/eternauta.jpg",
  "descripcion": "Una clásica historia de ciencia ficción argentina.",
  "disponible": true
}

### Actualizar un libro inexistente - 404
PUT {{baseUrl}}/api/libros/999
Content-Type: application/json

{
  "titulo": "Inexistente",
  "autor": "Sin autor",
  "precio": 0,
  "imagen": "",
  "descripcion": "",
  "disponible": false
}

### Borrar un libro
DELETE {{baseUrl}}/api/libros/6

### Borrar nuevamente el libro - 404
DELETE {{baseUrl}}/api/libros/6

### Listar autores
GET {{baseUrl}}/api/autores

### Obtener un autor
GET {{baseUrl}}/api/autores/1

### Autor inexistente - 404
GET {{baseUrl}}/api/autores/999

### Crear un autor - 201
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
  "nombre": "Julio Cortázar",
  "nacionalidad": "Argentina"
}

### Actualizar un autor
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{
  "nombre": "Héctor Germán Oesterheld",
  "nacionalidad": "Argentina"
}

### Actualizar un autor inexistente - 404
PUT {{baseUrl}}/api/autores/999
Content-Type: application/json

{
  "nombre": "Inexistente",
  "nacionalidad": "Desconocida"
}

### Borrar un autor
DELETE {{baseUrl}}/api/autores/5

### Borrar nuevamente el autor - 404
DELETE {{baseUrl}}/api/autores/5
